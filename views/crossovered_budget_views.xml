<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_crossovered_budget_form_inherit" model="ir.ui.view">
        <field name="name">crossovered.budget.form.inherit</field>
        <field name="model">crossovered.budget</field>
        <field name="inherit_id" ref="account_budget.view_crossovered_budget_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_create_budget_estimate" 
                        string="Estimate Run" 
                        type="object" 
                        class="oe_highlight"
                        groups="account.group_account_user"/>
            </xpath>
        </field>
    </record>
</odoo>