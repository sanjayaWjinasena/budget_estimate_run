<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="view_budget_estimate_form" model="ir.ui.view">
        <field name="name">budget.estimate.form</field>
        <field name="model">budget.estimate</field>
        <field name="arch" type="xml">
            <form string="Budget Estimate" edit="false">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="budget_id"/>
                            <field name="budget_name"/>
                        </group>
                        <group>
                            <field name="create_date" string="Creation Date"/>
                            <field name="create_uid" string="Created By"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Financial Summary">
                            <group>
                                <group string="Revenue">
                                    <field name="project_value" widget="monetary"/>
                                    <field name="actual_invoiced_amount" widget="monetary"/>
                                    <field name="estimated_revenue" widget="monetary"/>
                                </group>
                                <group string="Expenses">
                                    <field name="total_project_expenses" widget="monetary"/>
                                    <field name="actual_expenses_incurred" widget="monetary"/>
                                </group>
                                <group string="Margin">
                                    <field name="gross_margin" widget="monetary"/>
                                    <field name="gross_margin_percentage" widget="percentage"/>
                                </group>
                                <group string="Progress">
                                    <field name="project_completed_percentage" widget="percentage"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_budget_estimate_tree" model="ir.ui.view">
        <field name="name">budget.estimate.tree</field>
        <field name="model">budget.estimate</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="budget_id"/>
                <field name="create_date"/>
                <field name="create_uid"/>
                <field name="project_value" optional="hide"/>
                <field name="actual_invoiced_amount" optional="hide"/>
                <field name="total_project_expenses" optional="hide"/>
                <field name="actual_expenses_incurred" optional="hide"/>
                <field name="gross_margin" optional="hide"/>
                <field name="gross_margin_percentage" widget="percentage"/>
                <field name="project_completed_percentage" widget="percentage"/>
            </tree>
        </field>
    </record>

    <!-- Action with explicit view_ids for breadcrumbs -->
    <record id="action_budget_estimate" model="ir.actions.act_window">
        <field name="name">Budget Estimates</field>
        <field name="res_model">budget.estimate</field>
        <field name="view_mode">tree,form</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_budget_estimate_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_budget_estimate_form')})
        ]"/>
    </record>

    <!-- Place under Accounting > Management -->
    <menuitem id="menu_budget_estimate" 
              name="Budget Estimates" 
              parent="account.menu_management" 
              action="action_budget_estimate" 
              sequence="10"/>
</odoo>